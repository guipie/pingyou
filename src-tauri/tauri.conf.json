{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pingyou",
  "version": "../package.json",
  "identifier": "com.guipie.Pingyou",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "屏友",
        "url": "index.html",
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "minWidth": 400,
        "minHeight": 300,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "maximizable": false
      },
      {
        "label": "preference",
        "url": "/#/preference",
        "visible": false,
        "titleBarStyle": "Overlay",
        "skipTaskbar": false,
        "hiddenTitle": true,
        "minWidth": 800,
        "minHeight": 680
      },
      {
        "label": "winchat",
        "title": "输入栏",
        "url": "/#/winchat",
        "visible": false,
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "width": 520,
        "height": 93
      },
      {
        "label": "winmsg",
        "title": "消息",
        "url": "/#/winmsg",
        "visible": false,
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "width": 200,
        "height": 300
      },
      {
        "label": "provider-add",
        "title": "添加自定义模型",
        "url": "/#/provider-add",
        "visible": false,
        "shadow": false,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: blob: http://ipc.localhost asset: http://asset.localhost https://asset.localhost http://127.0.0.1:11435 https://py.lm56.top",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$RESOURCE/**",
            "$APPDATA/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb",
      "rpm"
    ],
    "shortDescription": "Pingyou",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/tray.png",
      "assets/models"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:pingyou.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1OTNCNUMyNjM2REM4MzcKUldRM3lHMWp3cldUTmRjdVluVnE1UkRCU3NERk40aEhRZStmT284dmhDWDBMUGpEdzdYVVo0YVEK",
      "endpoints": [
        "https://py.lm56.top/api/tauri/updates?target={{target}}&arch={{arch}}&version={{current_version}}"
      ]
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["pingyou"]
      }
    }
  }
}