{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the app windows (main/preference/winchat/winmsg/provider-add)",
  "windows": [
    "main",
    "preference",
    "winchat",
    "winmsg",
    "provider-add"
  ],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "https://api.deepseek.com"
        },
        {
          "url": "https://ark.cn-beijing.volces.com"
        },
        {
          "url": "https://dashscope.aliyuncs.com"
        },
        {
          "url": "https://generativelanguage.googleapis.com"
        },
        {
          "url": "https://api.openai.com"
        },
        {
          "url": "https://api.anthropic.com"
        },
        {
          "url": "https://open.bigmodel.cn"
        },
        {
          "url": "https://api.moonshot.cn"
        },
        {
          "url": "https://api.minimax.chat"
        },
        {
          "url": "https://gh-proxy.com"
        },
        {
          "url": "http://127.0.0.1:11435/*"
        }
      ]
    },
    "core:window:allow-set-shadow",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:deny-internal-toggle-maximize",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-decorations",
    "core:window:allow-set-position",
    "core:window:allow-set-theme",
    "core:window:allow-set-title",
    "core:webview:allow-webview-close",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-destroy",
    "admin-status:default",
    "custom-window:default",
    "os:default",
    "process:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    "pinia:default",
    "log:default",
    "updater:default",
    "prevent-default:default",
    "autostart:default",
    "macos-permissions:default",
    "dialog:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        "$EXEDIR/**",
        "$EXEDIR/assets/custom-models/**",
        "$APPDATA/**",
        "$APPDATA/custom-models/**",
        "$APPCONFIG/**",
        "$APPLOCALDATA/**",
        "$RESOURCE/**",
        "$APPLOG/**",
        "$HOME/**"
      ]
    },
    "clipboard-manager:allow-write-text",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "core:webview:allow-create-webview-window",
    "locale:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select"
  ]
}